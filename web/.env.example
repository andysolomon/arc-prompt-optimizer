# Model providers. Set any subset; a provider without a key simply drops out of the model list.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# MiniMax platform key (api.minimax.io): enables MiniMax M3 and M2.7.
MINIMAX_API_KEY=
# OpenCode Go subscription key: enables DeepSeek V4 Pro, GLM-5.3, Kimi K2.6, Qwen3.7 Plus.
OPENCODE_API_KEY=

# TypeSafe (Jev) judge. When absent the "Judge with Jev" switch is disabled.
TYPESAFE_API_KEY=

# Optional: shared rate limit store for /api/optimize (10 runs / 10 min per IP).
# Vercel KV / Upstash Redis REST credentials. Without them the limit is kept in process memory per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Accounts: sign in with Google or X. All of AUTH_SECRET and at least one provider pair are required; otherwise sign-in is hidden.
# Generate a secret with `openssl rand -base64 32`.
AUTH_SECRET=
# Google Cloud console OAuth client (Web application). Authorized redirect URI: https://<host>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# X developer portal OAuth 2.0 client (confidential). Callback URI: https://<host>/api/auth/callback/twitter
AUTH_TWITTER_ID=
AUTH_TWITTER_SECRET=
# Optional: canonical URL when the deployment is behind a proxy that rewrites Host. Vercel is detected automatically.
# AUTH_URL=https://your-domain.example

# Test-only: serve canned completions and judge answers instead of calling providers. Ignored in production.
# ARC_MOCK_PROVIDERS=1
