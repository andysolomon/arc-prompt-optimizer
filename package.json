{
  "name": "arc-prompt-optimizer",
  "version": "0.4.0",
  "private": true,
  "description": "Prompt pattern composition, evaluation, and ranking as a library, the arc-prompt CLI, and a Pi extension.",
  "keywords": [
    "pi-package",
    "prompt-engineering",
    "prompt-optimization"
  ],
  "type": "module",
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "bin": {
    "arc-prompt": "./bin/arc-prompt"
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./extension": {
      "types": "./dist/extension/index.d.ts",
      "import": "./dist/extension/index.js"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-skill-tools.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "verify:arc-pi": "npm run build && node scripts/verify-arc-pi.mjs",
    "prepack": "npm run build",
    "version": "node scripts/sync-plugin-version.mjs",
    "release": "semantic-release"
  },
  "files": [
    "bin/arc-prompt",
    "dist/**",
    "skills/**",
    ".claude-plugin/**",
    "commands/**"
  ],
  "pi": {
    "extensions": [
      "./dist/extension/index.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "semantic-release": "^25.0.7",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.4",
    "@earendil-works/pi-coding-agent": "^0.84.4"
  }
}
